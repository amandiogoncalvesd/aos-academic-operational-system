# ---- AOS Core ----
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# Postgres (dev via docker compose). Para testes locais sem Docker: sqlite+aiosqlite:///./aos.db
DATABASE_URL=postgresql+asyncpg://aos:aos@localhost:5432/aos
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Backend do Event Bus: memory | redis | kafka
EVENT_BUS_BACKEND=memory

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Frontend sem backend (Vercel) ----
# NEXT_PUBLIC_MOCK_API=true            # força modo simulado (contas em docs/contas-de-teste.md)
# NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=false # exige API real
# API_INTERNAL_URL=http://localhost:8000
