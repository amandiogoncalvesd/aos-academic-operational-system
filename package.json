{
  "name": "aos",
  "version": "0.1.0",
  "private": true,
  "description": "AOS — Academic Operational System (G Designer School). Monorepo Turborepo + pnpm.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "core:dev": "cd services/core && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "core:test": "cd services/core && pytest -q",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3"
  }
}
